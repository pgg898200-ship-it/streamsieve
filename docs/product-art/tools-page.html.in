<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>PGG Engineering · Tool index</title>
<meta name="description" content="Choose a PGG Engineering tool for search, inference, state replication, telemetry or evaluation. Browse practical examples and source code.">
<link rel="canonical" href="https://pgg898200-ship-it.github.io/cachepin/tools/">
<meta property="og:title" content="PGG Engineering · Tool index">
<meta property="og:description" content="$count engineering tools. Find a task, try an example and inspect the source.">
<meta property="og:type" content="website">
<meta property="og:url" content="https://pgg898200-ship-it.github.io/cachepin/tools/">
<meta property="og:image" content="https://pgg898200-ship-it.github.io/cachepin/tools/cover.png">
<meta property="og:image:alt" content="PGG Engineering’s visual index of $count developer tools.">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#FAFAFA">
<link rel="preload" href="fonts/instrument-sans.woff2" as="font" type="font/woff2" crossorigin>
<style>
@font-face{font-family:'Instrument Sans';src:url('fonts/instrument-sans.woff2') format('woff2');font-style:normal;font-weight:400 700;font-display:swap}
@font-face{font-family:'IBM Plex Mono';src:url('fonts/ibm-plex-mono.woff2') format('woff2');font-style:normal;font-weight:400;font-display:swap}
:root{color-scheme:light;--paper:#fafafa;--ink:#141619;--mute:#555c65;--line:#dadde1;--blue:#315bff;--sans:'Instrument Sans',Arial,sans-serif;--mono:'IBM Plex Mono',ui-monospace,monospace;background:var(--paper);color:var(--ink);font-family:var(--sans)}
*{box-sizing:border-box}html,body{margin:0}header,main,footer{width:min(calc(100% - clamp(40px,9vw,140px)),1450px);margin:auto}h1,h2,h3,h4,p,ul,figure{margin:0}ul{list-style:none;padding:0}a{color:inherit;text-decoration-thickness:1px;text-underline-offset:.23em}a:hover,a:focus-visible{color:var(--blue)}:focus-visible{outline:2px solid var(--blue);outline-offset:4px}button{font:inherit;cursor:pointer}button,a{touch-action:manipulation}::selection{background:var(--blue);color:#fff}[hidden]{display:none!important}.skip{position:absolute;top:8px;left:8px;z-index:8;padding:12px;background:var(--ink);color:white;transform:translateY(-180%)}.skip:focus{transform:none}
.mast{height:78px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--ink)}.brand{font-weight:650;letter-spacing:-.055em;font-size:23px;text-decoration:none;display:inline-flex;gap:12px;align-items:center}.stamp{display:inline-block;width:22px;height:21px;border:2px solid var(--ink);box-shadow:inset 0 -4px var(--paper),inset 0 -6px var(--ink);transform:skew(-14deg)}.mast nav,.actions,.links,.paging{display:flex;align-items:center}.mast nav{gap:30px}.mast nav a,footer a{display:inline-flex;gap:.3em;align-items:center;min-height:44px;text-decoration:none;font-size:14px}.mast nav a:first-child{border-bottom:1px solid var(--ink)}
.feature{display:grid;grid-template-columns:minmax(0,.88fr) minmax(0,1.12fr);gap:6%;align-items:center;padding:clamp(57px,6.8vw,107px) 0 clamp(58px,6vw,92px)}.eyebrow,.trace figcaption,.caption-small,.paging,.col-head,.axis,.row-text,.script-caption,footer{font-family:var(--mono)}.eyebrow{font-size:13px;letter-spacing:.015em;display:flex;align-items:center;gap:11px}.eyebrow a{text-decoration:none}.eyebrow .sep{color:var(--line)}.feature h1{font-size:clamp(57px,6.4vw,105px);font-weight:550;line-height:.96;letter-spacing:-.055em;margin:24px 0 24px;max-width:9ch}.feature p.lead{font-size:clamp(18px,1.55vw,24px);color:var(--mute);line-height:1.48;letter-spacing:-.03em;max-width:37ch}.actions{gap:23px;margin-top:28px;font-size:15px}.actions a{min-height:44px;display:inline-flex;align-items:center;gap:.6em}.primary{background:var(--blue);color:white;padding:0 18px;text-decoration:none;font-weight:550;border-radius:3px}.primary:hover,.primary:focus-visible{background:var(--ink);color:white}.actions a:last-child{color:var(--ink)}
.trace{container:trace / inline-size;min-width:0;border:1px solid var(--line);background:#fff}.trace figcaption{display:flex;align-items:center;justify-content:space-between;padding:18px 21px;border-bottom:1px solid var(--line);gap:14px;font-size:12px}.trace figcaption strong{font-family:var(--sans);font-size:16px;letter-spacing:-.025em}.caption-small{font-size:11px;color:var(--mute);letter-spacing:-.015em}.trace svg{width:100%;height:auto;display:block}.trace svg.compact{display:none}@container trace (max-width:525px){.trace svg.wide{display:none}.trace svg.compact{display:block}}.col-head{fill:var(--mute);font-size:11px}.axis{font-size:12px;fill:var(--mute)}.row-text{font-size:15px;fill:var(--ink)}.wire{stroke:var(--blue);stroke-width:2;fill:none}.port{fill:var(--blue)}.newer{fill:var(--blue)}.ctx{stroke:var(--line);fill:none;stroke-width:1}.trace-footer{padding:15px 21px;border-top:1px solid var(--line);min-height:74px;display:flex;align-items:center;gap:12px;justify-content:space-between}.script-caption{font-size:12px;color:var(--mute);line-height:1.55}.paging{gap:3px;flex-shrink:0}.paging button{border:1px solid transparent;padding:8px 9px;background:transparent;color:var(--mute);border-radius:3px;font-size:11px;min-height:34px}.paging button[aria-pressed=true]{color:var(--ink);border-color:var(--line);background:var(--paper)}.paging button:hover{color:var(--blue)}.trace [data-result]{transition:opacity .2s ease}.trace[data-mode=first] [data-result=second],.trace[data-mode=second] [data-result=first]{opacity:.23}
.index{border-top:1px solid var(--ink);padding:39px 0 49px}.index-head{display:grid;grid-template-columns:1fr auto;align-items:baseline;padding-bottom:36px;border-bottom:1px solid var(--line)}h2{font-size:clamp(45px,4.1vw,65px);line-height:1;font-weight:540;letter-spacing:-.055em}.index-count{font:13px var(--mono);color:var(--mute)}.directory{display:grid;grid-template-columns:minmax(175px,.62fr) minmax(0,2.38fr);gap:clamp(30px,5vw,90px);padding-top:29px}.directory nav{align-self:start;position:sticky;top:22px}.directory nav h3{font:12px var(--mono);color:var(--mute);margin:0 0 9px}.directory nav li a{padding:8px 0;display:inline-block;line-height:1.3;text-decoration:none;font-size:15px}.group+.group{margin-top:32px}.group h3{font-size:clamp(23px,2.1vw,34px);line-height:1.2;font-weight:550;letter-spacing:-.05em;margin:0 0 15px;scroll-margin-top:20px}.entries{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:27px}.entry{border-top:1px solid var(--line)}.entry article{display:grid;grid-template-columns:59px minmax(0,1fr);gap:16px;padding:23px 0 19px}.glyph{width:59px;height:59px;align-self:start}.glyph svg{display:block;width:100%;height:100%}.entry h4{font-weight:600;font-size:25px;line-height:1.1;letter-spacing:-.055em}.entry h4 a{text-decoration:none}.entry-copy p{font-size:16px;line-height:1.43;color:var(--mute);margin-top:6px}.links{gap:16px;margin-top:7px}.links a{display:inline-flex;align-items:center;min-height:32px;font:12px var(--mono)}.links a:first-child{color:var(--blue)}footer{border-top:1px solid var(--ink);padding:17px 0 27px;display:flex;align-items:center;justify-content:space-between;font-size:12px;color:var(--mute)}
@media(max-width:1000px){.feature{gap:3%;grid-template-columns:.85fr 1.15fr}.trace figcaption,.trace-footer{padding-inline:14px}.trace-footer{flex-wrap:wrap}.directory{grid-template-columns:180px minmax(0,1fr);gap:25px}.entry article{grid-template-columns:46px minmax(0,1fr);gap:10px}.glyph{width:46px;height:46px}.entries{column-gap:16px}}
@media(max-width:760px){.mast{height:59px}.brand{font-size:19px;gap:9px}.stamp{width:17px;height:17px}.mast nav{gap:16px}.mast nav a{font-size:12px}.feature{grid-template-columns:1fr;gap:29px;padding:38px 0}.feature h1{font-size:clamp(56px,11.5vw,83px);margin:16px 0;max-width:none}.feature p.lead{font-size:19px;max-width:44ch}.eyebrow{font-size:11px}.actions{margin-top:18px;font-size:14px}.trace{max-width:640px}.trace figcaption{padding:12px 13px}.trace-footer{padding:10px 13px;min-height:55px}.directory{grid-template-columns:1fr;gap:22px;padding-top:18px}.directory nav{position:static}.directory nav ul{display:flex;gap:0 20px;flex-wrap:wrap}.directory nav li a{padding:6px 0;border-bottom:1px solid var(--line);font-size:14px}.directory nav h3{margin-bottom:2px}.index{padding:26px 0}.index-head{padding-bottom:17px}.entries{column-gap:22px}.entry h4{font-size:22px}}
@media(max-width:520px){header,main,footer{width:calc(100% - 32px)}.feature h1{max-width:9ch}.mast nav{gap:13px}.trace figcaption strong{font-size:14px}.caption-small,.script-caption{font-size:10px}.trace-footer{row-gap:3px}.paging button{padding:7px 6px;font-size:10px}.index-count{font-size:11px}.entries{grid-template-columns:1fr}.entry article{grid-template-columns:60px minmax(0,1fr);gap:14px;padding:16px 0 12px}.glyph{width:58px;height:58px}.links a{min-height:35px}.group h3{font-size:25px}.entry-copy p{font-size:16px;line-height:1.4}.group+.group{margin-top:24px}}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{transition:none!important;animation:none!important;scroll-behavior:auto!important}}
</style>
</head>
<body id="top"><a class="skip" href="#index">Skip to the tool index</a>
<header class="mast"><a class="brand" href="#top"><i class="stamp" aria-hidden="true"></i>PGG Engineering</a><nav aria-label="Main"><a href="#index">Tool index</a><a href="https://github.com/pgg898200-ship-it">GitHub <span aria-hidden="true">↗</span></a></nav></header>
<main><section class="feature" aria-labelledby="feature-title"><div><div class="eyebrow"><a href="$source">Afterkey</a><span class="sep" aria-hidden="true">/</span><a href="#group-afterkey">State replication</a></div><h1 id="feature-title">Catch up a reader.</h1><p class="lead">Afterkey returns one row per key written since a reader’s last revision. Each row carries the latest value or a deletion.</p><div class="actions"><a class="primary" href="$demo">Try Afterkey <span aria-hidden="true">↗</span></a><a href="$source">Read the source</a></div></div>
<figure class="trace" id="trace"><figcaption><strong>Worker-slot revisions</strong><span class="caption-small">reader cursor r1</span></figcaption>
<svg class="wide" viewBox="0 0 550 238" role="img" aria-labelledby="trace-title trace-desc"><title id="trace-title">Four writes after revision one yield three rows.</title><desc id="trace-desc">Revision two sets key zero to seven. Revision three sets key one to twelve. Revision four replaces key zero with six. Revision five deletes key two. The returning reader receives revisions three and four on the first page and revision five on the second.</desc>
<g class="col-head"><text x="20" y="30">REV</text><text x="74" y="30">KEY ← SLOTS</text><text x="361" y="30">READER RECEIVES</text></g>
<path class="ctx" d="M20 42H530 M21 87H159 M21 126H159 M21 165H159 M21 204H159"/>
<g class="axis"><text x="20" y="73">r2</text><text x="20" y="112">r3</text><text x="20" y="151">r4</text><text x="20" y="190">r5</text></g>
<g class="row-text"><text x="74" y="73">0 ← 7</text><text x="74" y="112">1 ← 12</text><text x="74" y="151">0 ← 6</text><text x="74" y="190">2 ← ∅</text></g>
<path d="M155 68 H176 Q184 68 184 76 V135 Q184 146 195 146 H208" fill="none" stroke="#555c65" stroke-width="1.5" stroke-dasharray="4 4"/>
<g data-result="first"><path class="wire" d="M155 107 H200 C244 107 247 76 288 76 H337 M209 146 H230 C274 146 272 121 313 121 H337"/><circle class="port" cx="337" cy="76" r="4"/><circle class="port" cx="337" cy="121" r="4"/><g class="row-text"><text x="360" y="81">key 1: 12 slots</text><text x="360" y="126">key 0: 6 slots</text></g></g>
<g data-result="second"><path class="wire" d="M155 185 H245 C282 185 279 182 311 182 H337"/><rect class="port" x="333.5" y="178.5" width="7" height="7"/><text x="360" y="187" class="row-text">key 2: deleted</text></g>
<path d="M155 146H209" class="wire"/><circle cx="209" cy="146" r="4" fill="white" stroke="#315bff" stroke-width="2"/>
</svg>
<svg class="compact" viewBox="0 0 340 221" role="img" aria-labelledby="trace-small-title trace-small-desc"><title id="trace-small-title">Four writes after revision one yield three rows.</title><desc id="trace-small-desc">Revision two sets key zero to seven. Revision three sets key one to twelve. Revision four replaces key zero with six. Revision five deletes key two. The returning reader receives revisions three and four on the first page and revision five on the second.</desc>
<g class="col-head"><text x="10" y="30">REV</text><text x="50" y="30">KEY ← SLOTS</text><text x="207" y="30">READER RECEIVES</text></g>
<path class="ctx" d="M10 42H330 M10 87H107 M10 126H107 M10 165H107 M10 204H107"/>
<g class="axis"><text x="10" y="73">r2</text><text x="10" y="112">r3</text><text x="10" y="151">r4</text><text x="10" y="190">r5</text></g>
<g class="row-text"><text x="50" y="73">0 ← 7</text><text x="50" y="112">1 ← 12</text><text x="50" y="151">0 ← 6</text><text x="50" y="190">2 ← ∅</text></g>
<path d="M112 68 H118 Q124 68 124 76 V137 Q124 146 133 146 H139" fill="none" stroke="#555c65" stroke-width="1.5" stroke-dasharray="4 4"/>
<g data-result="first"><path class="wire" d="M112 107 H128 C153 107 158 76 181 76 H196 M140 146 H151 C170 146 166 121 188 121 H196"/><circle class="port" cx="196" cy="76" r="4"/><circle class="port" cx="196" cy="121" r="4"/><g class="row-text" style="font-size:13.5px"><text x="207" y="81">key 1: 12 slots</text><text x="207" y="126">key 0: 6 slots</text></g></g>
<g data-result="second"><path class="wire" d="M112 185 H170 C183 185 180 182 194 182 H196"/><rect class="port" x="192.5" y="178.5" width="7" height="7"/><text x="207" y="187" class="row-text" style="font-size:13.5px">key 2: deleted</text></g>
<path d="M112 146H140" class="wire"/><circle cx="140" cy="146" r="4" fill="white" stroke="#315bff" stroke-width="2"/>
</svg>
<div class="trace-footer"><span id="readout" class="script-caption" aria-live="polite">4 writes → 3 rows across 2 pages</span><div role="group" aria-label="Select a catch-up page" class="paging" hidden><button type="button" data-view="all" aria-pressed="true">All</button><button type="button" data-view="first" aria-pressed="false">Page 1</button><button type="button" data-view="second" aria-pressed="false">Page 2</button></div></div></figure></section>
<section class="index" aria-labelledby="index"><div class="index-head"><h2 id="index" tabindex="-1">Tool index</h2><span class="index-count">$count tools</span></div><div class="directory"><nav aria-label="Jump to a task"><h3>Browse by task</h3><ul>$nav</ul></nav><div>$groups</div></div></section></main>
<footer><span>PGG Engineering</span><a href="#top">Back to top ↑</a></footer>
<script>
const trace = document.getElementById('trace');
const paging = trace.querySelector('.paging');
const results = {all: '4 writes → 3 rows across 2 pages', first: 'Page 1 · revisions 3 and 4', second: 'Page 2 · revision 5'};
for (const button of paging.querySelectorAll('button')) {
  button.addEventListener('click', () => {
    const selected = button.dataset.view;
    trace.dataset.mode = selected;
    trace.querySelector('#readout').textContent = results[selected];
    for (const item of paging.querySelectorAll('button')) item.setAttribute('aria-pressed', String(item === button));
  });
}
paging.hidden = false;
</script></body></html>
